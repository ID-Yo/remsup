[Unit]
Description=Remsup pinned TLS endpoints
After=network.target remsup-relay.service

[Service]
Type=simple
ExecStart=/usr/bin/stunnel4 /etc/remsup/stunnel.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
